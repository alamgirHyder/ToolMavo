# Set these in Hostinger's Node.js Environment Variables panel.
NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_hostinger_database_name
DB_USER=replace_with_hostinger_database_user
DB_PASSWORD=replace_with_your_database_password
# Optional: DB_SSL=true for a remote database requiring verified TLS.
# Set TRUST_PROXY_HOPS only after confirming the host's proxy topology.
# PORT is normally injected by the hosting provider; local default is 8080.
# Docker local development also needs MYSQL_ROOT_PASSWORD.
